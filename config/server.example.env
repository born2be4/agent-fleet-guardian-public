# Copy this file outside git as .env and fill values locally.
# Never commit real secrets.

SERVER_NAME=personal-agent-server
HERMES_HOME=$HOME/.hermes
AGENT_SERVER_HOME=$HOME/agent-server
DEFAULT_PROVIDER=openai-codex
DEFAULT_MODEL=gpt-5.5

# Optional chat integration placeholders.
TELEGRAM_BOT_USERNAME=@your_bot_here
TELEGRAM_ALLOWED_USERS=comma,separated,ids

# Do not put real tokens in this tracked example.
TELEGRAM_BOT_TOKEN=<set-in-local-env-only>
PROVIDER_AUTH_PROFILE=<set-up-locally>
